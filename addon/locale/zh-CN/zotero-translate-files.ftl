    .label = 翻译成中文 PDF
zotero-translate-files-pref-base-url = 接口地址
zotero-translate-files-pref-api-key = API key
zotero-translate-files-pref-model = 模型名
zotero-translate-files-pref-max-output-tokens = 模型单次最大输出 token 数
zotero-translate-files-pref-max-requests = 单篇最多请求次数
zotero-translate-files-pref-repair-failed = 失败段落合并补译（单轮；超出单次预算时可用多个请求，均计入请求上限）
zotero-translate-files-pref-translate-references = 翻译参考文献
zotero-translate-files-log-path = 诊断日志：{ $path }
zotero-translate-files-pref-babeldoc-path = BabelDOC 路径
zotero-translate-files-pref-browse = 浏览…
zotero-translate-files-pref-test = 测试连接
zotero-translate-files-pref-request-help = 插件会尽量把整篇文档合并为少量请求；输出 token 估算按源文 token 的 1.6 倍加每段 20 token，并预留 10% 余量。超过单次上限时会拆分；截断后会将末项视为未确认并续传，只有没有完整项时才二分。每次实际 API 请求都计数。失败段落可在主请求完成后合并补译；补译请求也计入上限。参考文献默认保留原文。Chatanywhere 单篇硬上限为 100 次，建议将本项设得更低以保留额度；自动术语表和逐段重发均已关闭。
zotero-translate-files-pref-babeldoc-help = BabelDOC 由 scripts/install-babeldoc.ps1 安装。安装完成后，请复制脚本输出的默认路径；可填写 BabelDOC 的 babeldoc.exe 或环境中的 python.exe。
zotero-translate-files-pref-api-idle = 接口：尚未测试。
zotero-translate-files-pref-api-checking = 接口：正在测试连接…
zotero-translate-files-pref-api-missing = 接口：请填写接口地址、API key 和模型名。
zotero-translate-files-pref-api-key-in-url = 接口：地址中包含已填写的 API key。请从接口地址中移除，并只在 API key 栏中填写。
zotero-translate-files-pref-api-success = 接口：连接成功（HTTP { $status }）。
zotero-translate-files-pref-api-http-error = 接口：HTTP { $status }；响应：{ $body }
zotero-translate-files-pref-api-timeout = 接口：请求超过 30 秒仍未完成，已超时。
zotero-translate-files-pref-api-network-error = 接口：网络错误，未收到 HTTP 响应。
zotero-translate-files-pref-path-idle = BabelDOC：尚未检查路径。
zotero-translate-files-pref-path-empty = BabelDOC：请填写可执行文件路径。
zotero-translate-files-pref-path-babeldoc-missing = BabelDOC：所选可执行文件不存在。
zotero-translate-files-pref-path-unrecognized = BabelDOC：请选择 babeldoc.exe 或环境中的 python.exe。
zotero-translate-files-pref-path-python-missing = BabelDOC 可执行文件存在，但找不到 Python：{ $path }
zotero-translate-files-pref-path-success = BabelDOC 路径有效；Python：{ $path }
zotero-translate-files-pref-path-picker-error = 无法打开文件选择器。
zotero-translate-files-pref-picker-title = 选择 BabelDOC 可执行文件
zotero-translate-files-pref-picker-filter = 可执行文件（*.exe）
zotero-translate-files-import-tag-warning-title = 译本已添加，但无法标记为已翻译
